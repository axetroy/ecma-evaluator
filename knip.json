{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"workspaces": {
		".": {
			"entry": [
				"src/index.{js,ts,tsx}",
				"docs/.vitepress/config.mts",
				"docs/.vitepress/theme/index.ts"
			],
			"ignore": [
				"rslib.config.js",
				"fixtures/**/*.(c|m)?js",
				"benchmark/**/*.(c|m)?js",
				"test/dist.test.js"
			]
		}
	},
	"ignoreDependencies": ["monaco-editor"]
}
