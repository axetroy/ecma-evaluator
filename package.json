{
    "name": "ecma-evaluator",
    "version": "2.0.10",
    "packageManager": "pnpm@12.4.1",
    "private": false,
    "description": "A tiny and fast JavaScript expression evaluator.",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "dist/cjs/index.cjs",
    "module": "dist/esm/index.mjs",
    "exports": {
        "./package.json": {
            "import": "./package.json",
            "require": "./package.json"
        },
        ".": {
            "require": {
                "default": "./dist/cjs/index.cjs",
                "types": "./dist/cjs/index.d.cts"
            },
            "import": {
                "default": "./dist/esm/index.mjs",
                "types": "./dist/esm/index.d.mts"
            }
        }
    },
    "scripts": {
        "test": "node --test **/*.test.js",
        "test:update-snapshots": "node --test-update-snapshots --test **/*.test.js",
        "build": "knip && rslib build",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "prepack": "pnpm run build",
        "changeset:version": "changeset version",
        "release": "changeset publish"
    },
    "author": "Axetroy <axetroy.dev@gmail.com>",
    "license": "SEE LICENSE IN LICENSE",
    "devDependencies": {
        "@changesets/cli": "2.31.1",
        "@rslib/core": "^0.18.0",
        "@types/node": "^22.14.1",
        "capture-stdio.js": "^1.0.2",
        "knip": "^5.53.0",
        "monaco-editor": "^0.57.0",
        "typescript": "^5.9.3",
        "vitepress": "1.6.4"
    },
    "keywords": [
        "expression",
        "evaluator",
        "eval",
        "expression-evaluator",
        "template",
        "template-engine",
        "sandbox",
        "safe-eval",
        "javascript",
        "ecmascript",
        "parser",
        "acorn"
    ],
    "homepage": "https://github.com/axetroy/ecma-evaluator#readme",
    "bugs": {
        "url": "https://github.com/axetroy/ecma-evaluator/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/axetroy/ecma-evaluator.git"
    },
    "dependencies": {
        "acorn": "^8.15.0",
        "globals": "^16.5.0"
    }
}
